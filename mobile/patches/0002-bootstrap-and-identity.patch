+    /// Seed one coherent official client set. Existing updated clients are never downgraded.
+    /// Missing-file repair is allowed only when all existing pinned files match byte-for-byte.
+    func prepareDesktopBootstrap(prefix: URL) async throws {
+        guard !busy, wine_process_is_running() == 0, wineserver_is_running() == 0 else {
+            throw SteamRuntimeFiles.Failure.activeSession
+        }
+        busy = true
+        defer { busy = false }
+        let fm = FileManager.default
+        let prefix = prefix.resolvingSymlinksInPath().standardizedFileURL
+        let drive = prefix.appendingPathComponent("drive_c")
+        let relative = "Program Files/Steam Big Picture"
+        _ = try SteamRuntimeFiles.destination(relative, under: drive)
+        let target = try SteamRuntimeFiles.destination(relative + "/steam.exe", under: drive)
+        func validPE(_ file: URL) -> Bool {
+            guard let values = try? file.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey]),
+                  values.isRegularFile == true, values.isSymbolicLink == false,
+                  let handle = try? FileHandle(forReadingFrom: file) else { return false }
+            defer { try? handle.close() }
+            guard let data = try? handle.read(upToCount: 64), data.count == 64,
+                  data.prefix(2) == Data([0x4d, 0x5a]) else { return false }
+            let offset = UInt64(data[60]) | UInt64(data[61]) << 8 | UInt64(data[62]) << 16 | UInt64(data[63]) << 24
+            guard offset >= 64, offset <= 1_048_576 else { return false }
+            do {
+                try handle.seek(toOffset: offset)
+                guard let pe = try handle.read(upToCount: 6), pe.count == 6,
+                      pe.prefix(4) == Data([0x50, 0x45, 0, 0]) else { return false }
+                return (pe[4] == 0x4c && pe[5] == 1) || (pe[4] == 0x64 && pe[5] == 0x86)
+            } catch { return false }
+        }
+        let hasClient = validPE(target)
+        func hasModule(_ name: String) -> Bool {
+            guard let url = try? SteamRuntimeFiles.destination(relative + "/" + name, under: drive) else { return false }
+            return validPE(url)
+        }
+        let hasGUI = hasModule("bin/vgui2_s.dll") || hasModule("win64/vgui2_s.dll")
+        let hasClientLibrary = hasModule("steamclient.dll") || hasModule("steamclient64.dll")
+        if hasClient && hasGUI && hasClientLibrary { return }
+        // Keep an existing updated or foreign install intact. No mixed-version overwrite.
+        let catalog = try await desktopSupportCatalog()
+        let packages = catalog?.packages ?? SteamRuntimeFiles.packages.map {
+            MobileSupportCatalog.Package(file: $0.file, bytes: $0.bytes, sha256: $0.sha256)
+        }
+        let clientHash = catalog?.clientSHA256 ?? SteamRuntimeFiles.clientSHA256
+        let stage = fm.temporaryDirectory.resolvingSymlinksInPath().appendingPathComponent("gamebridge-steam-" + UUID().uuidString)
+        try fm.createDirectory(at: stage, withIntermediateDirectories: false)
+        defer { try? fm.removeItem(at: stage) }
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.httpCookieStorage = nil
+        configuration.urlCredentialStorage = nil
+        configuration.timeoutIntervalForRequest = 60
+        configuration.timeoutIntervalForResource = 900
+        let session = URLSession(configuration: configuration, delegate: SteamRuntimeRedirects(), delegateQueue: nil)
+        defer { session.invalidateAndCancel() }
+        var names = Set<String>(), files: [String] = []
+        for package in packages {
+            try Task.checkCancellation()
+            guard let url = URL(string: SteamRuntimeFiles.origin + package.file) else {
+                throw SteamRuntimeFiles.Failure.invalidPackage
+            }
+            let (temporary, response) = try await session.download(from: url)
+            defer { try? fm.removeItem(at: temporary) }
+            guard let http = response as? HTTPURLResponse, http.statusCode == 200,
+                  http.url?.host == url.host, http.url?.scheme == "https",
+                  (try temporary.resourceValues(forKeys: [.fileSizeKey])).fileSize == package.bytes else {
+                throw SteamRuntimeFiles.Failure.invalidPackage
+            }
+            let archive = try Data(contentsOf: temporary, options: .mappedIfSafe)
+            guard Self.hash(archive) == package.sha256 else { throw SteamRuntimeFiles.Failure.invalidPackage }
+            try SteamRuntimeFiles.unpack(archive) { name, bytes in
+                guard names.insert(name.lowercased()).inserted else { throw SteamRuntimeFiles.Failure.invalidPackage }
+                let file = try SteamRuntimeFiles.destination(name, under: stage)
+                try fm.createDirectory(at: file.deletingLastPathComponent(), withIntermediateDirectories: true)
+                try bytes.write(to: file, options: .withoutOverwriting)
+                files.append(name)
+            }
+        }
+        guard validPE(stage.appendingPathComponent("steam.exe")),
+              validPE(stage.appendingPathComponent("bin/vgui2_s.dll")),
+              Self.hash(try Data(contentsOf: stage.appendingPathComponent("steamclient64.dll"))) == clientHash else {
+            throw SteamRuntimeFiles.Failure.invalidPackage
+        }
+        try Task.checkCancellation()
+        guard wine_process_is_running() == 0, wineserver_is_running() == 0 else {
+            throw SteamRuntimeFiles.Failure.activeSession
+        }
+        if !fm.fileExists(atPath: prefix.appendingPathComponent(".update-timestamp").path),
+           ["system.reg", "user.reg"].contains(where: { fm.fileExists(atPath: prefix.appendingPathComponent($0).path) }) {
+            throw SteamRuntimeFiles.Failure.conflict
+        }
+        madeira_seed_prefix_if_needed(prefix.path)
+        // Verify every existing file in the known cohort before copying any missing file.
+        // steam.exe is installed last; interrupted first installs can be retried.
+        var missing: [(URL, URL)] = []
+        for name in files.sorted(by: { ($0 == "steam.exe" ? 1 : 0, $0) < ($1 == "steam.exe" ? 1 : 0, $1) }) {
+            let destination = try SteamRuntimeFiles.destination(relative + "/" + name, under: drive)
+            let source = stage.appendingPathComponent(name)
+            if fm.fileExists(atPath: destination.path) {
+                let values = try destination.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey])
+                guard values.isRegularFile == true, values.isSymbolicLink == false,
+                      fm.contentsEqual(atPath: destination.path, andPath: source.path) else {
+                    throw SteamRuntimeFiles.Failure.conflict
+                }
+            } else {
+                missing.append((source, destination))
+            }
+        }
+        for (source, destination) in missing {
+            try fm.createDirectory(at: destination.deletingLastPathComponent(), withIntermediateDirectories: true)
+            let temp = destination.deletingLastPathComponent().appendingPathComponent(".gamebridge-" + UUID().uuidString)
+            defer { try? fm.removeItem(at: temp) }
+            try fm.copyItem(at: source, to: temp)
+            try fm.moveItem(at: temp, to: destination)
+        }
+    }
+
+    /// The configured trust anchor is part of the native app signature. There is no
+    /// production signing key in source control; unconfigured builds use bundled pins.
+    private func desktopSupportCatalog() async throws -> MobileSupportCatalog.Payload? {
+        let info = Bundle.main
+        let keyID = info.object(forInfoDictionaryKey: "GameBridgeSupportKeyID") as? String ?? ""
+        let encodedKey = info.object(forInfoDictionaryKey: "GameBridgeSupportPublicKey") as? String ?? ""
+        if (keyID.isEmpty || keyID == "$(GAMEBRIDGE_SUPPORT_KEY_ID)") && (encodedKey.isEmpty || encodedKey == "$(GAMEBRIDGE_SUPPORT_PUBLIC_KEY)") { return nil }
+        guard !keyID.isEmpty, keyID.utf8.count <= 64,
+              let publicKey = Data(base64Encoded: encodedKey), publicKey.count == 32 else {
+            throw SteamRuntimeFiles.Failure.invalidPackage
+        }
+        // This is only a data endpoint; archive downloads still go directly to Valve.
+        let url = URL(string: "https://raw.githubusercontent.com/enoswong/GameBridge/refs/heads/support-catalog/mobile/steam-seed.json")!
+        let store = UserDefaults.standard
+        let cacheKey = "GameBridge.acceptedSteamCatalog." + keyID
+        let cached = store.data(forKey: cacheKey)
+        struct Cached: Codable {
+            let envelope: Data
+            let revision: Int
+            let digest: String
+        }
+        let previous = try cached.map { try JSONDecoder().decode(Cached.self, from: $0) }
+        let now = Int(Date().timeIntervalSince1970)
+        func verify(_ data: Data) throws -> MobileSupportCatalog.Verified {
+            try MobileSupportCatalog.verify(data, keyID: keyID, publicKey: publicKey, now: now,
+                minimumRevision: previous?.revision ?? 0, acceptedDigest: previous?.digest)
+        }
+        let config = URLSessionConfiguration.ephemeral
+        config.httpCookieStorage = nil
+        config.urlCredentialStorage = nil
+        config.timeoutIntervalForRequest = 15
+        config.timeoutIntervalForResource = 30
+        let session = URLSession(configuration: config, delegate: SteamRuntimeRedirects(), delegateQueue: nil)
+        defer { session.invalidateAndCancel() }
+        do {
+            var request = URLRequest(url: url)
+            request.cachePolicy = .reloadIgnoringLocalCacheData
+            let (stream, response) = try await session.bytes(for: request)
+            guard let http = response as? HTTPURLResponse, http.statusCode == 200, http.url == url,
+                  http.expectedContentLength <= Int64(MobileSupportCatalog.maxEnvelopeBytes) else {
+                throw SteamRuntimeFiles.Failure.invalidPackage
+            }
+            var data = Data()
+            for try await byte in stream {
+                try Task.checkCancellation()
+                guard data.count < MobileSupportCatalog.maxEnvelopeBytes else {
+                    throw SteamRuntimeFiles.Failure.invalidPackage
+                }
+                data.append(byte)
+            }
+            let verified = try verify(data)
+            let accepted = Cached(envelope: data, revision: verified.payload.revision, digest: verified.digest)
+            store.set(try JSONEncoder().encode(accepted), forKey: cacheKey)
+            return verified.payload
+        } catch {
+            try Task.checkCancellation()
+            if let previous { return try verify(previous.envelope).payload }
+            // No previously accepted revision: the shipped pins remain the fallback.
+            return nil
+        }
+    }
+
+    private static func hash(_ data: Data) -> String { SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined() }
 }
 #endif
