+    /// Deliberately excludes file paths, device identifiers, account names and raw logs.
+    private var gameBridgeDiagnostics: String {
+        let memory = ProcessInfo.processInfo.physicalMemory / (1024 * 1024)
+        let signing = SigningStatus.current.debuggable ? "development/debuggable" : "not debuggable"
+        let ready = StikJITHelper.ready ? "ready" : "not ready"
+        let bootstrap = LibraryEntry.steamClientInstalled ? "present" : "absent"
+        let guest = wine_process_is_running() != 0 || wineserver_is_running() != 0 ? "active" : "idle"
+        return [
+            "GameBridge iOS research",
+            "OS: \(UIDevice.current.systemVersion)",
+            "Physical memory MiB: \(memory)",
+            "Signing: \(signing)",
+            "JIT: \(ready)",
+            "Steam bootstrap: \(bootstrap)",
+            "Wine session: \(guest)",
+            "Last requested stage: \(gameBridgeStage)",
+            "Last component report: \(gameBridgeLastSteamHealth)",
+            "Recent loader signals: \(MobileSupportSignals.shared.recent().joined(separator: ", "))",
+            "Steam login and gameplay acceptance: unverified"
+        ].joined(separator: "\n")
+    }
+
+    private var gameBridgeSupportIssueURL: URL? {
+        guard !gameBridgeLastSteamHealth.isEmpty || !MobileSupportSignals.shared.recent().isEmpty else { return nil }
+        var parts = URLComponents(string: "https://github.com/enoswong/GameBridge/issues/new")
+        let signals = MobileSupportSignals.shared.recent().joined(separator: ", ")
+        let body = "GameBridge iOS research component report\n"
+            + "iOS: \(UIDevice.current.systemVersion)\n"
+            + "Component states: \(gameBridgeLastSteamHealth)\n"
+            + "Recent loader signals: \(signals)\n"
+        parts?.queryItems = [
+            URLQueryItem(name: "title", value: "[iOS] Steam component failure"),
+            URLQueryItem(name: "body", value: body)
+        ]
+        return parts?.url
+    }
+
+    /// Record only a bounded list of known component names and their PE state.
+    /// UserDefaults is outside the guest Documents directory; no automatic upload.
+    private func gameBridgeRecordSteamHealth(phase: String) {
+        guard let documents = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask).first else { return }
+        let drive = documents.appendingPathComponent("wine/drive_c").resolvingSymlinksInPath()
+        let base = "Program Files/Steam Big Picture/"
+        let modules = ["steam.exe", "bin/vgui2_s.dll", "win64/vgui2_s.dll",
+                       "steamclient.dll", "steamclient64.dll", "steamui.dll",
+                       "bin/filesystem_stdio.dll", "win64/filesystem_stdio.dll"]
+        var states: [String: String] = [:]
+        for name in modules {
+            guard let url = try? SteamRuntimeFiles.destination(base + name, under: drive),
+                  let values = try? url.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey, .fileSizeKey]),
+                  values.isRegularFile == true, values.isSymbolicLink == false else {
+                states[name] = "missing-or-conflict"; continue
+            }
+            guard let size = values.fileSize, size > 0, size <= 64 * 1024 * 1024,
+                  let imports = try? PortableWindowsImportReader.read(url) else {
+                states[name] = "invalid-or-unreadable"; continue
+            }
+            states[name] = imports.architecture
+        }
+        let report: [String: Any] = ["schema": 1, "phase": phase, "modules": states]
+        if let data = try? JSONSerialization.data(withJSONObject: report, options: [.sortedKeys]),
+           let json = String(data: data, encoding: .utf8) {
+            gameBridgeLastSteamHealth = json
+            LogStore.shared.log("[gamebridge-health] " + json)
+        }
+    }
+
+    private func gameBridgeAudit(prefix: URL) async {
+        do {
+            let audit = try await Task.detached(priority: .utility) {
+                try SteamDirectoryAudit.scan(prefix: prefix)
+            }.value
+            let families = audit.unresolvedFamilies.joined(separator: ", ")
+            gameBridgeAuditMessage = "Checked \(audit.reports.count) game folders."
+            if !families.isEmpty { gameBridgeAuditMessage += " Unresolved imports: \(families)." }
+            if audit.isPartial { gameBridgeAuditMessage += " Partial scan; more checks are needed." }
+            LogStore.shared.log("[gamebridge] " + gameBridgeAuditMessage)
+        } catch {
+            gameBridgeAuditMessage = "Dependency scan unavailable; Steam remains available."
+            LogStore.shared.log("[gamebridge] " + gameBridgeAuditMessage)
+        }
+    }
