+    private func gameBridgeCheckSupport() {
+        guard !gameBridgePreparing, library.current == nil, library.startingJIT == nil,
+              !library.launching, wine_process_is_running() == 0, wineserver_is_running() == 0 else { return }
+        gameBridgePreparing = true
+        gameBridgeStage = "Checking signed GitHub support catalog…"
+        Task { @MainActor in
+            defer { gameBridgePreparing = false }
+            do {
+                gameBridgeSupportStatus = try await SteamRuntimeInstaller.shared.checkDesktopSupport()
+                gameBridgeStage = "Support check complete"
+            } catch {
+                gameBridgeSupportStatus = "Support catalog unavailable or invalid; existing client files unchanged."
+                gameBridgeStage = "Support check incomplete"
+            }
+        }
+    }
+
+    private func gameBridgeOpenSteam(launch: Bool = true) {
+        guard !gameBridgePreparing, library.current == nil, library.startingJIT == nil,
+              !library.launching, !VCRedistModel.shared.busy,
+              wine_process_is_running() == 0, wineserver_is_running() == 0 else { return }
+        library.error = nil
+        guard SigningStatus.current.debuggable else {
+            gameBridgeStage = "Development signing required"
+            library.error = "Install a development-signed research build with get-task-allow before enabling JIT."
+            return
+        }
+        gameBridgeAuditMessage = ""
+        gameBridgePreparing = true
+        Task { @MainActor in
+            defer { gameBridgePreparing = false }
+            do {
+                guard let documents = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask).first else {
+                    throw SteamRuntimeFiles.Failure.prefixMissing
+                }
+                let prefix = documents.appendingPathComponent("wine")
+                gameBridgeStage = "Checking and preparing official Steam components…"
+                gameBridgeRecordSteamHealth(phase: "before-preparation")
+                try await SteamRuntimeInstaller.shared.prepareDesktopBootstrap(prefix: prefix)
+                gameBridgeRecordSteamHealth(phase: "after-preparation")
+                guard LibraryEntry.steamClientInstalled else { throw SteamRuntimeFiles.Failure.invalidPackage }
+                gameBridgeStage = "Checking game dependencies…"
+                await gameBridgeAudit(prefix: prefix)
+                if gameBridgeAutoPrepareVC {
+                    gameBridgeStage = "Preparing Visual C++ runtimes…"
+                    do {
+                        try await VCRedistModel.shared.prepareForSteam()
+                        LogStore.shared.log("[gamebridge] Visual C++ v14 checked; overlay applies at guest startup.")
+                    } catch {
+                        try Task.checkCancellation()
+                        gameBridgeAuditMessage += " Optional Visual C++ preparation incomplete; existing files kept."
+                        LogStore.shared.log("[gamebridge] optional VC preparation incomplete: \(error.localizedDescription)")
+                    }
+                }
+                guard library.current == nil, wine_process_is_running() == 0,
+                      wineserver_is_running() == 0 else { throw SteamRuntimeFiles.Failure.activeSession }
+                if launch {
+                    gameBridgeStage = "Requesting local Windows Steam session"
+                    launchLibraryEntry(.bigPictureEntry)
+                } else {
+                    gameBridgeStage = "Component preparation complete; Steam not started"
+                }
+            } catch {
+                gameBridgeStage = "Preparation incomplete"
+                gameBridgeRecordSteamHealth(phase: "preparation-failed")
+                library.error = error.localizedDescription
+            }
+        }
+    }
