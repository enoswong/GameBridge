+        let bat = [
+            "@echo off",
+            "rem GameBridge desktop Steam research",
+            "start \"\" \"C:\\windows\\system32\\services.exe\"",
+            "cd /d \"\(folder.windows)\"",
+            "\"\(folder.windows)\\steam.exe\" -cef-disable-gpu",
+        ].joined(separator: "\r\n") + "\r\n"
+        let path = documents.appendingPathComponent("wine/drive_c/big-picture.bat")
+        do {
+            try bat.write(to: path, atomically: true, encoding: .utf8)
+        } catch {
+            LogStore.shared.log("[gamebridge-steam] could not create launch batch: \(error.localizedDescription)",
+                                level: .error)
+            return false
+        }
+        LogStore.shared.log("[gamebridge-steam] starting genuine desktop client")
+        return true
