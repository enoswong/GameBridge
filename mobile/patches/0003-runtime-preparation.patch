new file mode 100644
--- /dev/null
+++ b/app/Madeira/RuntimeDependencyPolicy.swift
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+/// Identifies runtime families from a PE import name; detection is not proof of absence.
+public enum RuntimeDependencyPolicy {
+    public static func component(for name: String) -> String? {
+        guard name.lowercased().hasSuffix(".dll") else { return nil }
+        let families = [
+            ("80", "2005"), ("90", "2008"), ("100", "2010"), ("110", "2012"), ("120", "2013"), ("140", "v14")
+        ]
+        let prefixes = ["msvcr", "msvcp", "msvcm", "mfc", "mfcm", "atl", "vcomp", "vcruntime", "concrt", "vccorlib"]
+        let basename = String(name.lowercased().dropLast(4))
+        let family = families.first { version, _ in
+            prefixes.contains { prefix in
+                let stem = prefix + version
+                return basename == stem || basename == stem + "u" || basename.hasPrefix(stem + "_")
+            }
+        }
+        if let family { return "Visual C++ " + family.1 }
+        if ["d3dx9_", "d3dx10_", "d3dx11_", "xactengine", "x3daudio1_"].contains(where: basename.hasPrefix)
+            || ["xinput1_3", "xaudio2_7", "d3dcompiler_43"].contains(basename) {
+            return "DirectX June 2010"
+        }
+        if basename == "mscoree" { return ".NET Framework" }
+        if ["openal32", "wrap_oal"].contains(basename) { return "OpenAL" }
+        if ["physxloader", "physxloader64", "physxcore"].contains(basename) { return "PhysX" }
+        if basename.hasPrefix("microsoft.xna.framework") { return "XNA Framework" }
+        return nil
+    }
+}
diff --git a/app/Madeira/PortableWindowsImportReader.swift b/app/Madeira/PortableWindowsImportReader.swift
new file mode 100644
--- /dev/null
+++ b/app/Madeira/PortableWindowsImportReader.swift
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+import Foundation
+
+public enum PortableWindowsImportReader {
+    public struct Imports {
+        public let architecture: String
+        public let libraries: Set<String>
+    }
+
+    private enum FormatError: Error {
+        case invalidHeader, invalidImportTable, oversizedImage
+    }
+
+    public static func read(_ file: URL) throws -> Imports {
+        let size = try file.resourceValues(forKeys: [.fileSizeKey]).fileSize ?? 0
+        guard size <= 256 * 1024 * 1024 else { throw FormatError.oversizedImage }
+        let image = try Image(Data(contentsOf: file, options: .alwaysMapped))
+        let regular = try image.imports(directory: 1, delayed: false)
+        let delayed = try image.imports(directory: 13, delayed: true)
+        return Imports(architecture: image.architecture, libraries: regular.union(delayed))
+    }
+
+    private struct Section {
+        let virtualAddress: Int
+        let rawOffset: Int
+        let rawSize: Int
+    }
+
+    private struct Image {
+        let data: Data
+        let architecture: String
+        let imageBase: UInt64
+        let directoryStart: Int
+        let directoryCount: Int
+        let sections: [Section]
+
+        init(_ data: Data) throws {
+            self.data = data
+            guard data.u16(0) == 0x5a4d, let header = data.u32(0x3c),
+                  data.u32(header) == 0x4550, let magic = data.u16(header + 24),
+                  let machine = data.u16(header + 4), let sectionCount = data.u16(header + 6),
+                  let optionalSize = data.u16(header + 20), (1...96).contains(sectionCount) else {
+                throw FormatError.invalidHeader
+            }
+            let optional = header + 24
+            let directoryOffset: Int
+            switch (machine, magic) {
+            case (0x14c, 0x10b):
+                architecture = "x86"
+                directoryOffset = 96
+                imageBase = UInt64(data.u32(optional + 28) ?? 0)
+            case (0x8664, 0x20b):
+                architecture = "x64"
+                directoryOffset = 112
+                let low = UInt64(data.u32(optional + 24) ?? 0)
+                let high = UInt64(data.u32(optional + 28) ?? 0)
+                imageBase = low | (high << 32)
+            default:
+                throw FormatError.invalidHeader
+            }
+            guard optionalSize >= directoryOffset, let count = data.u32(optional + directoryOffset - 4) else {
+                throw FormatError.invalidHeader
+            }
+            directoryStart = optional + directoryOffset
+            directoryCount = min(count, (optionalSize - directoryOffset) / 8)
+            sections = try Self.readSections(data, at: optional + optionalSize, count: sectionCount)
+        }
+
+        private static func readSections(_ data: Data, at start: Int, count: Int) throws -> [Section] {
+            guard start + count * 40 <= data.count else { throw FormatError.invalidHeader }
+            return try (0..<count).map { index in
+                let header = start + index * 40
+                guard let address = data.u32(header + 12), let rawSize = data.u32(header + 16),
+                      let rawOffset = data.u32(header + 20) else { throw FormatError.invalidHeader }
+                return Section(virtualAddress: address, rawOffset: rawOffset, rawSize: rawSize)
+            }
+        }
+
+        func imports(directory index: Int, delayed: Bool) throws -> Set<String> {
+            guard index < directoryCount, let address = data.u32(directoryStart + index * 8),
+                  let size = data.u32(directoryStart + index * 8 + 4), address != 0 else { return [] }
+            let step = delayed ? 32 : 20
+            guard size >= step, let start = offset(address) else { throw FormatError.invalidImportTable }
+            var result = Set<String>()
+            for index in 0..<min(size / step, 4096) {
+                let row = start + index * step
+                guard let rawName = data.u32(row + (delayed ? 4 : 12)) else {
+                    throw FormatError.invalidImportTable
+                }
+                if rawName == 0 { return result }
+                let name = try nameAddress(rawName, row: row, delayed: delayed)
+                guard let location = offset(name), let library = data.importName(at: location) else {
+                    throw FormatError.invalidImportTable
+                }
+                result.insert(library)
+            }
+            throw FormatError.invalidImportTable
+        }
+
+        private func nameAddress(_ rawName: Int, row: Int, delayed: Bool) throws -> Int {
+            guard delayed, let attributes = data.u32(row), attributes & 1 == 0 else { return rawName }
+            guard UInt64(rawName) >= imageBase else { throw FormatError.invalidImportTable }
+            return Int(UInt64(rawName) - imageBase)
+        }
+
+        private func offset(_ address: Int) -> Int? {
+            for section in sections where address >= section.virtualAddress {
+                let difference = address - section.virtualAddress
+                if difference < section.rawSize, section.rawOffset + difference < data.count {
+                    return section.rawOffset + difference
+                }
+            }
+            return nil
+        }
+    }
+}
+
+private extension Data {
+    func u16(_ offset: Int) -> Int? {
+        guard offset >= 0, offset + 2 <= count else { return nil }
+        return Int(self[offset]) | (Int(self[offset + 1]) << 8)
+    }
+
+    func u32(_ offset: Int) -> Int? {
+        guard let low = u16(offset), let high = u16(offset + 2) else { return nil }
+        return low | (high << 16)
+    }
+
+    func importName(at offset: Int) -> String? {
+        let bytes = self[offset..<Swift.min(offset + 260, count)]
+        guard let end = bytes.firstIndex(of: 0), end > offset else { return nil }
+        let name = bytes[..<end]
+        guard name.allSatisfy({ (32...126).contains($0) && ![47, 58, 92].contains($0) }) else { return nil }
+        return String(bytes: name, encoding: .ascii)?.lowercased()
+    }
+}
diff --git a/app/Madeira/PortableLegacyGameAudit.swift b/app/Madeira/PortableLegacyGameAudit.swift
new file mode 100644
--- /dev/null
+++ b/app/Madeira/PortableLegacyGameAudit.swift
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+import Foundation
+
+public struct PortableLegacyGameAudit: Encodable, Sendable {
+    public enum AuditError: Error, Sendable { case unavailableDirectory(String) }
+
+    public struct Import: Encodable, Sendable, Hashable {
+        public let name: String
+        public let architecture: String
+        public let component: String?
+    }
+
+    public let directory: URL
+    public let executablesScanned: Int
+    public let unreadableExecutables: [String]
+    public let scanLimitReached: Bool
+    public let runtimeImports: [Import]
+    public let unresolvedImports: [Import]
+
+    public var summary: String {
+        var lines = [directory.path, "已檢查 \(executablesScanned) 個 Windows EXE／DLL。"]
+        let components = Set(runtimeImports.compactMap(\.component)).sorted()
+        if !components.isEmpty { lines.append("偵測到共用依賴：\(components.joined(separator: "、"))") }
+        for item in unresolvedImports {
+            lines.append("未在已檢查位置找到：\(item.name)（\(item.architecture)）")
+        }
+        for item in unreadableExecutables { lines.append("未能讀取匯入表：\(item)") }
+        if scanLimitReached { lines.append("已達掃描檔案上限。可選擇個別遊戲子目錄重查。") }
+        if executablesScanned == 0 { lines.append("此目錄暫無可讀嘅 x86／x64 Windows 執行檔。") }
+        return lines.joined(separator: "\n")
+    }
+
+    public static func scan(directory: URL, prefix: URL? = nil, maxExecutables: Int = 2048) throws -> Self {
+        let limit = min(2048, max(1, maxExecutables))
+        let directory = directory.standardizedFileURL.resolvingSymlinksInPath()
+        let keys: [URLResourceKey] = [.isRegularFileKey, .isSymbolicLinkKey]
+        guard directory.isFileURL, try directory.resourceValues(forKeys: [.isDirectoryKey]).isDirectory == true,
+              let files = FileManager.default.enumerator(
+                  at: directory, includingPropertiesForKeys: keys, options: [.skipsHiddenFiles]
+              ) else { throw AuditError.unavailableDirectory(directory.path) }
+        var scan = Scan(prefix: prefix)
+        var visited = 0
+        for case let file as URL in files {
+            try Task.checkCancellation()
+            let values = try? file.resourceValues(forKeys: Set(keys))
+            if values?.isSymbolicLink == true {
+                files.skipDescendants()
+                continue
+            }
+            guard values?.isRegularFile == true, ["exe", "dll"].contains(file.pathExtension.lowercased()) else {
+                continue
+            }
+            visited += 1
+            if visited > limit { break }
+            scan.inspect(file)
+        }
+        return Self(
+            directory: directory, executablesScanned: scan.count, unreadableExecutables: scan.errors.sorted(),
+            scanLimitReached: visited > limit, runtimeImports: scan.runtime.sorted(by: Self.order),
+            unresolvedImports: scan.unresolved.sorted(by: Self.order)
+        )
+    }
+
+    private static func order(_ lhs: Import, _ rhs: Import) -> Bool {
+        (lhs.name, lhs.architecture) < (rhs.name, rhs.architecture)
+    }
+
+    public static func component(for name: String) -> String? {
+        RuntimeDependencyPolicy.component(for: name)
+    }
+
+    private struct Scan {
+        let prefix: URL?
+        var count = 0
+        var errors: [String] = []
+        var runtime = Set<Import>()
+        var unresolved = Set<Import>()
+        var directoryFiles: [URL: Set<String>] = [:]
+        var architectureFiles: [String: Set<String>] = [:]
+
+        mutating func inspect(_ file: URL) {
+            do {
+                let imports = try PortableWindowsImportReader.read(file)
+                count += 1
+                let local = names(in: file.deletingLastPathComponent())
+                let system = systemNames(for: imports.architecture)
+                for name in imports.libraries {
+                    let item = Import(
+                        name: name, architecture: imports.architecture,
+                        component: PortableLegacyGameAudit.component(for: name)
+                    )
+                    if item.component != nil { runtime.insert(item) }
+                    if !name.hasPrefix("api-ms-win-"), !name.hasPrefix("ext-ms-win-"),
+                       !local.contains(name), !system.contains(name) {
+                        unresolved.insert(item)
+                    }
+                }
+            } catch {
+                errors.append(file.path)
+            }
+        }
+
+        private mutating func systemNames(for architecture: String) -> Set<String> {
+            guard let prefix else { return [] }
+            let windows = prefix.appending(path: "drive_c/windows")
+            if let cached = architectureFiles[architecture] { return cached }
+            let wow64 = windows.appending(path: "syswow64")
+            let system = architecture == "x86" && FileManager.default.fileExists(atPath: wow64.path)
+                ? wow64 : windows.appending(path: "system32")
+            var available = names(in: system)
+            let assemblies = windows.appending(path: "winsxs")
+            let children = (try? FileManager.default.contentsOfDirectory(
+                at: assemblies, includingPropertiesForKeys: [.isDirectoryKey, .isSymbolicLinkKey]
+            )) ?? []
+            let family = architecture == "x86" ? "x86_microsoft.vc" : "amd64_microsoft.vc"
+            for child in children where child.lastPathComponent.lowercased().hasPrefix(family) {
+                let attributes = try? child.resourceValues(forKeys: [.isDirectoryKey, .isSymbolicLinkKey])
+                guard attributes?.isDirectory == true, attributes?.isSymbolicLink == false else { continue }
+                available.formUnion(names(in: child))
+            }
+            architectureFiles[architecture] = available
+            return available
+        }
+
+        private mutating func names(in directory: URL) -> Set<String> {
+            if let names = directoryFiles[directory] { return names }
+            let keys: Set<URLResourceKey> = [.isRegularFileKey, .isSymbolicLinkKey]
+            let files = (try? FileManager.default.contentsOfDirectory(
+                at: directory, includingPropertiesForKeys: Array(keys)
+            )) ?? []
+            let names = Set(files.compactMap { file -> String? in
+                let values = try? file.resourceValues(forKeys: keys)
+                guard values?.isRegularFile == true, values?.isSymbolicLink == false else { return nil }
+                return file.lastPathComponent.lowercased()
+            })
+            directoryFiles[directory] = names
+            return names
+        }
+    }
+}
